# Copy to .streamlit/secrets.toml (git-ignored) and fill in your Cloudflare
# TURN key (Dashboard → Realtime → TURN Server). On Streamlit Community Cloud,
# paste these same lines into the app's Settings → Secrets instead.
# Leave them empty to run with STUN only (fine for localhost).
CF_TURN_KEY_ID = ""
CF_TURN_API_TOKEN = ""
